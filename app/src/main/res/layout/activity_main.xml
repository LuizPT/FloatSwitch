<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/screen_content_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="@dimen/screen_content_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/screen_title"
                    android:textColor="@color/screen_text_primary"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/languageButton"
                    android:layout_width="@dimen/language_header_button_width"
                    android:layout_height="@dimen/language_header_touch_height"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_marginEnd="@dimen/language_header_toggle_spacing"
                    android:background="@drawable/bg_language_header_button"
                    android:clickable="true"
                    android:contentDescription="@string/language_selector_description_automatic"
                    android:focusable="true"
                    android:paddingHorizontal="@dimen/language_header_image_padding_horizontal"
                    android:paddingVertical="@dimen/language_header_image_padding_vertical"
                    android:scaleType="centerInside"
                    android:src="@drawable/flag_united_kingdom"
                    app:tint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/overlayToggleButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="@dimen/overlay_toggle_width"
                    android:layout_height="@dimen/overlay_toggle_min_touch_size"
                    android:checkable="true"
                    android:contentDescription="@string/overlay_toggle_description_off"
                    android:enabled="false"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:minWidth="@dimen/overlay_toggle_width"
                    android:minHeight="@dimen/overlay_toggle_min_touch_size"
                    android:paddingHorizontal="@dimen/overlay_toggle_horizontal_padding"
                    android:text="@string/overlay_toggle_off"
                    android:textAllCaps="false"
                    android:textColor="@color/overlay_toggle_text_tint"
                    android:textSize="@dimen/overlay_toggle_text_size"
                    android:textStyle="bold"
                    app:backgroundTint="@color/overlay_toggle_background_tint"
                    app:cornerRadius="@dimen/overlay_toggle_corner_radius"
                    app:strokeColor="@color/overlay_toggle_stroke_tint"
                    app:strokeWidth="@dimen/overlay_toggle_stroke_width" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/screen_description"
                android:textColor="@color/screen_text_secondary"
                android:textSize="@dimen/text_size_body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/overlay_move_guidance"
                android:textColor="@color/screen_text_secondary"
                android:textSize="@dimen/text_size_body" />

            <me.diluir.floatswitch.OverlayAppearanceControlsView
                android:id="@+id/overlayAppearanceControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/applications_heading"
                android:textColor="@color/screen_text_primary"
                android:textSize="@dimen/text_size_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/applicationCountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/application_count_initial"
                android:textColor="@color/screen_text_secondary"
                android:textSize="@dimen/text_size_body" />

            <LinearLayout
                android:id="@+id/selectedApplicationsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addApplicationButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:minHeight="@dimen/action_button_min_height"
                android:text="@string/button_add_application"
                android:textAllCaps="false" />

            <LinearLayout
                android:id="@+id/overlayPermissionBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/overlayPermissionState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/status_background"
                    android:padding="@dimen/status_padding"
                    android:text="@string/overlay_permission_missing"
                    android:textColor="@color/status_missing_text"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/grantOverlayPermissionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:minHeight="@dimen/app_slot_button_min_height"
                    android:text="@string/button_grant_overlay_permission"
                    android:textAllCaps="false" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoStartSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:minHeight="@dimen/action_button_min_height"
                android:text="@string/auto_start_title"
                android:textColor="@color/screen_text_primary"
                android:textSize="@dimen/text_size_body" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/positionLockSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/position_lock_description_off"
                android:minHeight="@dimen/action_button_min_height"
                android:text="@string/position_lock_title"
                android:textColor="@color/screen_text_primary"
                android:textSize="@dimen/text_size_body" />

            <me.diluir.floatswitch.OverlayBackgroundControlsView
                android:id="@+id/overlayBackgroundControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/app_list_divider_height"
                android:layout_marginTop="@dimen/spacing_large"
                android:background="@color/app_list_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/status_log_heading"
                android:textColor="@color/screen_text_primary"
                android:textSize="@dimen/text_size_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/autoStartDiagnostic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/auto_start_diagnostic_never"
                android:textColor="@color/screen_text_secondary"
                android:textSize="@dimen/text_size_body" />

            <TextView
                android:id="@+id/feedbackText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:accessibilityLiveRegion="polite"
                android:text="@string/initial_guidance"
                android:textColor="@color/screen_text_secondary"
                android:textSize="@dimen/text_size_body" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
